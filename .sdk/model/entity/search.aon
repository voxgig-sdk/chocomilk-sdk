# Entity: search

main: kit: entity: search: {

  alias: field: {}

  fields: [
    {
      name: "author"
      req: false
      short: "Pin author/creator"
      type: "`$STRING`"
    }
    {
      name: "description"
      req: false
      short: "Pin description"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "Pinterest pin ID"
      type: "`$STRING`"
    }
    {
      name: "image"
      req: false
      short: "Pin image URL"
      type: "`$STRING`"
    }
    {
      name: "title"
      req: false
      short: "Pin title"
      type: "`$STRING`"
    }
    {
      name: "url"
      req: false
      short: "Pinterest pin URL"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "search"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: "minecraft"
                kind: "query"
                name: "query"
                orig: "query"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/search/pinterest"
          parts: [
            "search"
            "pinterest"
          ]
          select: {
            "$action": "pinterest"
            exist: [
              "query"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.results`"
          }
        }
      ]
    }
  }



}
