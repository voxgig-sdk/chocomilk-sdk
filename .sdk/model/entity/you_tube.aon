# Entity: you_tube

main: kit: entity: you_tube: {

  alias: field: {}

  fields: [
    {
      name: "channel"
      req: false
      short: "Channel name"
      type: "`$STRING`"
    }
    {
      name: "duration"
      req: false
      short: "Video duration"
      type: "`$STRING`"
    }
    {
      name: "thumbnail"
      req: false
      short: "Video thumbnail URL"
      type: "`$STRING`"
    }
    {
      name: "title"
      req: false
      short: "Video title"
      type: "`$STRING`"
    }
    {
      name: "videoId"
      req: false
      short: "YouTube video ID"
      type: "`$STRING`"
    }
    {
      name: "views"
      req: false
      short: "View count"
      type: "`$STRING`"
    }
  ]

  name: "you_tube"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: "mrbeast"
                kind: "query"
                name: "query"
                orig: "query"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/youtube/search"
          parts: [
            "youtube"
            "search"
          ]
          select: {
            exist: [
              "query"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.results`"
          }
        }
      ]
    }
  }



}
